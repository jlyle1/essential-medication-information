# Line endings: LF for cross-platform source consumed by sushi / IG Publisher,
# CRLF for Windows-native scripts. Scoped by extension to avoid renormalizing
# anything unlisted.
*.fsh    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.xml    text eol=lf
*.svg    text eol=lf
*.puml   text eol=lf
*.html   text eol=lf
*.ini    text eol=lf
*.sh     text eol=lf
*.bat    text eol=crlf
